# ============================================================
# ISODISTORT —— 子项目级 .gitignore
# ============================================================

# ---------- Python 常规 ----------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/
*.log

# ---------- 虚拟环境（本子项目不自建；共用 CRIS/.venv） ----------
.venv/

# ---------- 测试 / 静态检查缓存 ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- 开发验证资料 ----------
# 测试与可复现审计脚本属于源码并进入版本控制；只忽略可重建数据、
# 一次性探针和运行输出。
tests_dev/manual/_*
tests_dev/manual/*.txt

# ---------- 程序运行输出（导出的 CIF/POSCAR/JSON/临时上传） ----------
output/

# ---------- 开发者端测试数据（可重新生成/下载，不提交） ----------
# 生成式 30-CIF 测试集：python tests_dev/manual/make_cifs_30.py 重建
tests_dev/cifs_30/
# COD 外部结构（来源见 docs/EXTERNAL_CIF_SOURCES.md）：
# python tests_dev/manual/fetch_cod_cifs.py 重新下载
tests_dev/cifs_external/
