# ============================================================
# ISODISTORT_VALIDATE —— 子项目级 .gitignore
# ============================================================

# ---------- Python 常规 ----------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/
*.log

# ---------- 虚拟环境 ----------
.venv/

# ---------- 测试 / 静态检查缓存 ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.pytest-tmp/
pytest-cache-files-*/

# ---------- 运行输出 / 比对产物 ----------
output/

# 本地比对目录（item = 待验证 CIF，true = 官网参考 CIF）均不入库
compare/
